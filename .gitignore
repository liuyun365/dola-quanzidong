**/state/
dola_engine/state/**
*.dpapi
*.sqlite3
dola_engine/pool/
pending_shots.json

# ---- 运行日志 / 后端日志 ----
*.log
app.log
app.log.err
_backend.log
_backend.out.log

# ---- 用户本地配置与关联数据（含本机路径） ----
added_items.json
bad_instances.json
asset_links.json
asset_lib.json

# ---- 用户剧本 / 素材 / 文档 ----
